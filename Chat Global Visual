local function playClickAnimation(button)
    local uiScale = button:FindFirstChild("UIScale") or Instance.new("UIScale", button)
    local tweenDown = TweenService:Create(uiScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.9})
    local tweenUp = TweenService:Create(uiScale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
    tweenDown:Play()
    tweenDown.Completed:Wait()
    tweenUp:Play()
end

local function playButtonTriggerAnimation(button, originalColor)
    local uiScale = button:FindFirstChild("UIScale") or Instance.new("UIScale", button)
    local clickScaleTween = TweenService:Create(uiScale, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.92})
    local clickColorTween = TweenService:Create(button, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)})
    local releaseScaleTween = TweenService:Create(uiScale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
    local releaseColorTween = TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundColor3 = originalColor})
    
    clickScaleTween:Play()
    clickColorTween:Play()
    clickScaleTween.Completed:Wait()
    releaseScaleTween:Play()
    releaseColorTween:Play()
end

local function makeDraggable(dragArea, targetFrame)
    local dragging = false
    local dragInput, mousePos, framePos

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = input
            mousePos = input.Position
            framePos = targetFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - mousePos
            TweenService:Create(targetFrame, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
            }):Play()
        end
    end)
end

local function createAnnouncement(sender, message, isRainbowText, isAnonymous)
    if not message or message == "" then return end
    
    local isRainbowName = false
    local isCursedName = false
    
    -- Kiểm tra thứ tự ưu tiên: Lệnh quỷ dữ [---] trước, sau đó mới tới [--]
    if string.find(message, "%[%-%-%-%]") then
        isCursedName = true
        message = string.gsub(message, "%[%-%-%-%]%s*", "")
    elseif string.find(message, "%[%-%-%]") then
        isRainbowName = true
        message = string.gsub(message, "%[%-%-%]%s*", "")
    end
    
    if message == "" then return end 
    
    local nameToShow = ""
    if not isAnonymous then
        nameToShow = (sender.DisplayName and sender.DisplayName ~= "" and sender.DisplayName ~= sender.Name) and sender.DisplayName or sender.Name
    end
    
    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(0, 0, 0, 45)
    frame.Position = UDim2.new(0.5, 0, 0, 0)
    frame.AnchorPoint = Vector2.new(0.5, 0)
    frame.Parent = container
    
    local profilePic = Instance.new("ImageLabel")
    profilePic.Size = UDim2.new(0, 36, 0, 36)
    profilePic.BackgroundTransparency = 1
    profilePic.Position = UDim2.new(0, 0, 0.5, -18)
    profilePic.Parent = frame

    local textStartX = 46

    if isAnonymous then
        profilePic.Visible = false
        textStartX = 10 
    else
        profilePic.Visible = true
        profilePic.Image = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png", sender.UserId)
    end
    
    local usernameLabel = Instance.new("TextLabel")
    usernameLabel.BackgroundTransparency = 1
    usernameLabel.Font = Enum.Font.GothamBold
    usernameLabel.TextStrokeTransparency = 0.2
    usernameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    usernameLabel.TextSize = 22
    usernameLabel.TextXAlignment = Enum.TextXAlignment.Left
    usernameLabel.Size = UDim2.new(0, 200, 1, 0)
    usernameLabel.Position = UDim2.new(0, textStartX, 0, 0)
    usernameLabel.Parent = frame
    
    -- XỬ LÝ LỆNH ẨN TÊN HIỂN THỊ
    if isCursedName then
        usernameLabel.Text = isAnonymous and "☠ :" or (nameToShow .. cursedIcon .. " :")
        usernameLabel.TextColor3 = Color3.fromRGB(220, 0, 0)
        
        -- Dải màu Đỏ Máu pha Đen rùng rợn
        local cursedGradient = Instance.new("UIGradient")
        cursedGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(40, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
        })
        cursedGradient.Parent = usernameLabel
        
        -- Vòng lặp Glitch giật lag điên cuồng
        task.spawn(function()
            local origPos = usernameLabel.Position
            while usernameLabel and usernameLabel.Parent do
                -- Giật khung hình (Jittering)
                usernameLabel.Position = origPos + UDim2.new(0, math.random(-2, 2), 0, math.random(-2, 2))
                cursedGradient.Rotation = math.random(0, 360)
                -- Viền nhấp nháy đỏ chớp tắt
                if math.random() > 0.6 then
                    usernameLabel.TextStrokeColor3 = Color3.fromRGB(255, 0, 0)
                    usernameLabel.TextStrokeTransparency = 0
                else
                    usernameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
                    usernameLabel.TextStrokeTransparency = 0.2
                end
                task.wait(0.04) -- Tốc độ glitch cực nhanh
            end
        end)
        
    elseif isRainbowName then
        usernameLabel.Text = isAnonymous and "\u{E000} :" or (nameToShow .. verifiedIcon .. " :")
        usernameLabel.TextColor3 = Color3.new(1, 1, 1)
        local nameGradient = Instance.new("UIGradient")
        nameGradient.Color = rainbowColorSequence
        nameGradient.Parent = usernameLabel
        task.spawn(function()
            local rot = 0
            while usernameLabel and usernameLabel.Parent do
                rot = (rot + 3) % 360
                nameGradient.Rotation = rot
                task.wait(0.02)
            end
        end)
    else
        -- Bình thường
        usernameLabel.Text = isAnonymous and "\u{E000} :" or (nameToShow .. verifiedIcon .. " :")
        usernameLabel.TextColor3 = isAnonymous and Color3.fromRGB(180, 180, 180) or Color3.fromRGB(0, 255, 150)
    end
    
    task.wait(0.01)
    usernameLabel.Size = UDim2.new(0, usernameLabel.TextBounds.X, 1, 0)
    
    local maxWidth = 450
    local messageWidth = #message * 10
    local totalTextWidth = usernameLabel.TextBounds.X + messageWidth
    local scale = (totalTextWidth + textStartX > maxWidth) and (maxWidth / (totalTextWidth + textStartX)) or 1
  
    local messageLabel = Instance.new("TextLabel")
    messageLabel.BackgroundTransparency = 1
    messageLabel.Font = Enum.Font.GothamBold
    messageLabel.Text = " " .. message
    messageLabel.TextStrokeTransparency = 0.2
    messageLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    messageLabel.TextSize = 22 * scale
    messageLabel.TextXAlignment = Enum.TextXAlignment.Left
    messageLabel.Size = UDim2.new(0, math.clamp(messageWidth * scale, 0, maxWidth - textStartX - usernameLabel.TextBounds.X - 10), 1, 0)
    messageLabel.Position = UDim2.new(0, textStartX + usernameLabel.TextBounds.X + 5, 0, 0)
    messageLabel.Parent = frame

    if isRainbowText then
        messageLabel.TextColor3 = Color3.new(1, 1, 1) 
        local textGradient = Instance.new("UIGradient")
        textGradient.Color = rainbowColorSequence
        textGradient.Parent = messageLabel
        
        task.spawn(function()
            local rot = 0
            while messageLabel and messageLabel.Parent do
                rot = (rot + 3) % 360
                textGradient.Rotation = rot
                task.wait(0.02)
            end
        end)
    else
        messageLabel.TextColor3 = Color3.new(1, 1, 1)
    end
    
    local messageStroke = Instance.new("UIStroke")
    messageStroke.Thickness = 2
    messageStroke.Color = Color3.new(0, 0, 0)
    messageStroke.Parent = messageLabel
    
    for _, msg in ipairs(container:GetChildren()) do
        if msg:IsA("Frame") and msg ~= frame then
            TweenService:Create(msg, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Position = msg.Position + UDim2.new(0, 0, 0, 50)}):Play()
        end
    end
    
    local finalWidth = math.clamp(textStartX + usernameLabel.TextBounds.X + messageLabel.TextBounds.X + 15, 150, maxWidth)
    frame.Size = UDim2.new(0, 0, 0, 45)
    frame:TweenSize(UDim2.new(0, finalWidth, 0, 45), "Out", "Back", 0.3, true)
    
    task.delay(12, function()
        if frame and frame.Parent then
            frame:TweenSize(UDim2.new(0, 0, 0, 45), "In", "Quad", 0.3, true)
            task.wait(0.3)
            frame:Destroy()
        end
    end)
end

