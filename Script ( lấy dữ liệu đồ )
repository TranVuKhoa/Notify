    while task.wait(1) do
        if not rootPart then continue end
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not loggedItems[obj] then
                if (obj.Position - rootPart.Position).Magnitude <= 30 then
                    if obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector") or obj:FindFirstChildOfClass("TouchTransmitter") then
                        loggedItems[obj] = true
                        AddItemToList(obj)
                    end
                end
            end
        end
    end
end))

