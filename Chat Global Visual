local touchBirthTimes = {}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        touchBirthTimes[input] = tick()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    touchBirthTimes[input] = nil
end)

local toggleInput = nil
local dragStartPos = nil
local dragFramePos = nil
local isDraggingMenu = false
local isMenuOpen = false
local toggleDebounce = false

innerToggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local birthTime = touchBirthTimes[input] or tick()
        if (tick() - birthTime) > 0.5 then
            return 
        end
        
        if not toggleInput then
            toggleInput = input
            dragStartPos = input.Position
            dragFramePos = toggleBtn.Position
            isDraggingMenu = false
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == toggleInput and dragStartPos then
        local delta = input.Position - dragStartPos
        
        if not isDraggingMenu and delta.Magnitude > 2 then
            isDraggingMenu = true
        end
        
        if isDraggingMenu then
            TweenService:Create(toggleBtn, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = UDim2.new(dragFramePos.X.Scale, dragFramePos.X.Offset + delta.X, dragFramePos.Y.Scale, dragFramePos.Y.Offset + delta.Y)
            }):Play()
        end
    end
end)

local function handleToggleRelease(input)
    if input == toggleInput then
        local wasDragging = isDraggingMenu
        
        toggleInput = nil
        isDraggingMenu = false
        dragStartPos = nil
        
        if not wasDragging then
            if toggleDebounce then return end
            toggleDebounce = true
            isMenuOpen = not isMenuOpen
            
            playClickSound("toggle")
            task.spawn(function() playClickAnimation(toggleBtn) end)
            
            if isMenuOpen then
                dashboard.Visible = true
                dashboard.Size = UDim2.new(0, 100, 0, 60)
                dashboard.GroupTransparency = 1 
                
                local tween = TweenService:Create(dashboard, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(0, 420, 0, 240),
                    GroupTransparency = 0
                })
                tween:Play()
                tween.Completed:Wait()
            else
                local tween = TweenService:Create(dashboard, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 100, 0, 60),
                    GroupTransparency = 1
                })
                tween:Play()
                tween.Completed:Wait() 
                if not isMenuOpen then dashboard.Visible = false end 
            end
            
            task.wait(0.1) 
            toggleDebounce = false
        end
    end
end

innerToggle.InputEnded:Connect(handleToggleRelease)
UserInputService.InputEnded:Connect(handleToggleRelease)

local connection1, connection2, connection3
connection1 = RunService.RenderStepped:Connect(function(dt)
    if not btnGradient3.Parent then connection1:Disconnect() return end
    btnGradient3.Rotation = (btnGradient3.Rotation + dt * 100) % 360
end)
connection2 = RunService.RenderStepped:Connect(function(dt)
    if not toggleGradient.Parent then connection2:Disconnect() return end
    toggleGradient.Rotation = (toggleGradient.Rotation + dt * 150) % 360
end)
connection3 = RunService.RenderStepped:Connect(function(dt)
    if not btnGradient4.Parent then connection3:Disconnect() return end
    btnGradient4.Rotation = (btnGradient4.Rotation + dt * 100) % 360
end)

local function setupButtonEffects(btn, originalColor)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.new(originalColor.R*1.2, originalColor.G*1.2, originalColor.B*1.2)}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = originalColor}):Play() end)
end
setupButtonEffects(normalButton, normalButton.BackgroundColor3)
setupButtonEffects(rainbowButton, rainbowButton.BackgroundColor3)
setupButtonEffects(anonNormalButton, anonNormalButton.BackgroundColor3)
setupButtonEffects(anonRainbowButton, anonRainbowButton.BackgroundColor3)
setupButtonEffects(clearBtn, clearBtn.BackgroundColor3)

