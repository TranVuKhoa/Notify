-- ==========================================
local function isBlacklisted(name)
    for _, blocked in ipairs(BlacklistNames) do
        if name == blocked or name:match("^Part") then return true end
    end
    return false
end

local function AddItemToList(instance)
    if not instance or not instance:IsDescendantOf(game) then return end
    if isBlacklisted(instance.Name) then return end

    -- Đẩy index xuống để item mới luôn lên đầu
    orderIndex = orderIndex - 1
    local currentOrder = orderIndex

    -- Tạo Khung chứa cho từng dòng (Gồm Tên + Nút Ghim)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -5, 0, 30)
    Row.BackgroundTransparency = 1
    Row.LayoutOrder = currentOrder
    Row:SetAttribute("IsPinned", false)
    Row.Parent = ScrollFrame
    
    itemToRow[instance] = Row -- Lưu dòng này lại

    local ItemBtn = Instance.new("TextButton")
    ItemBtn.Size = UDim2.new(1, -25, 1, 0)
    ItemBtn.BackgroundTransparency = 1
    ItemBtn.Text = instance.Name
    ItemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ItemBtn.Font = Enum.Font.GothamBold
    ItemBtn.TextSize = 16
    ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
    ItemBtn.Parent = Row

    -- Nút Ghim
    local PinBtn = Instance.new("TextButton")
    PinBtn.Size = UDim2.new(0, 25, 1, 0)
    PinBtn.Position = UDim2.new(1, -25, 0, 0)
    PinBtn.BackgroundTransparency = 1
    PinBtn.Text = "☆" -- Trạng thái chưa ghim
    PinBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    PinBtn.Font = Enum.Font.GothamBold
    PinBtn.TextSize = 18
    PinBtn.Parent = Row

    local Underline = Instance.new("Frame")
    Underline.Size = UDim2.new(1, 0, 0, 1)
    Underline.Position = UDim2.new(0, 0, 1, 0)
    Underline.BackgroundColor3 = Color3.fromRGB(220, 180, 50)
    Underline.BorderSizePixel = 0
    Underline.Parent = Row

    -- Sự kiện chọn Item
    ItemBtn.MouseButton1Click:Connect(function()
        activeItem = instance
        CodeViewerBox.Text = "game." .. instance:GetFullName()
        
        for _, child in pairs(ScrollFrame:GetChildren()) do
            if child:IsA("Frame") then
                local btn = child:FindFirstChildOfClass("TextButton")
                if btn then btn.TextColor3 = Color3.fromRGB(255, 255, 255) end
            end
        end
        ItemBtn.TextColor3 = Color3.fromRGB(220, 180, 50)
    end)

    -- Sự kiện Ghim Item
    PinBtn.MouseButton1Click:Connect(function()
        local isPinned = not Row:GetAttribute("IsPinned")
        Row:SetAttribute("IsPinned", isPinned)
        
        if isPinned then
            PinBtn.Text = "★"
            PinBtn.TextColor3 = Color3.fromRGB(220, 180, 50)
            Row.LayoutOrder = currentOrder - 200000 -- Đẩy lên trên cùng (rất nhỏ)
        else
            PinBtn.Text = "☆"
            PinBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
            Row.LayoutOrder = currentOrder -- Trả lại vị trí theo thứ tự lúc nhặt
        end
    end)
end

