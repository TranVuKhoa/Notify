    Icon.TextColor3 = Color3.fromRGB(220, 180, 50)
    Icon.Font = Enum.Font.GothamBold
    Icon.TextSize = 22
    Icon.Parent = Btn

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0.4, 0)
    Label.Position = UDim2.new(0, 0, 0.6, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(220, 180, 50)
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 11
    Label.Parent = Btn
    
    if name ~= "DELETE" then
        local Sep = Instance.new("Frame")
        Sep.Size = UDim2.new(0, 1, 0.5, 0)
        Sep.Position = UDim2.new(1, 12, 0.25, 0)
        Sep.BackgroundColor3 = Color3.fromRGB(220, 180, 50)
        Sep.BorderSizePixel = 0
        Sep.Parent = Btn
    end

    return Btn
end

